# Environment variables for the /edit page (set these in Netlify:
# Site configuration → Environment variables). They are only read by the
# Netlify Functions in netlify/functions, never sent to the browser.

# The password the editor types at /edit. Choose something easy to remember.
EDITOR_PASSWORD=

# Random string used to sign login sessions. Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
SESSION_SECRET=

# Fine-grained GitHub token with Contents: Read and write on this repository.
# This is what commits the edits, so it never reaches the browser.
GITHUB_TOKEN=

# owner/repo that holds the content.
GITHUB_REPO=Nothka/NoulTestament

# Branch to commit to. Netlify builds this branch.
GITHUB_BRANCH=main
